{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/runtime/index.ts",
    "src/errors.ts",
    "src/protocol/crypto.ts",
    "src/storage/**/*",
    "src/authority-core/**/*",
    "src/owner-client/**/*",
    "src/agent-client/**/*",
    "src/broker-gateway/**/*",
    "src/issuer-client/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
